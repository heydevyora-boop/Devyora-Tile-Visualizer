PORT=3001
AI_API_KEY=your_key_here
# NEVER put a real key in this file — it is tracked by git and pushed to GitHub.
# Put the real key in server/.env instead (gitignored).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the image model (defaults to gemini-3.1-flash-image)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
MONGODB_URI=your_mongodb_uri_here
