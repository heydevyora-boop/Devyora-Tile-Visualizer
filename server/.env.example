PORT=3001

# NEVER put a real key in this file — it is tracked by git and pushed to GitHub.
# Put the real key in server/.env instead (gitignored).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the image model (defaults to gemini-3.1-flash-lite-image)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
MONGODB_URI=your_mongodb_uri_here

# --- Sign-in (showroom accounts) --------------------------------------------
# NEVER put real accounts or a real secret in this file — placeholders only.
#
# AUTH_ACCOUNTS_JSON — a JSON array of sign-in accounts. Each account is
# {username, passwordHash, role, displayName}. passwordHash is a bcrypt hash,
# never the plaintext password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('the-password', 10))"
# To add a salesperson: hash their password with the command above, append an
# entry with role "user", redeploy. To remove someone: delete their entry,
# redeploy.
AUTH_ACCOUNTS_JSON=[{"username":"admin","passwordHash":"$2a$10$replace_with_a_real_bcrypt_hash","role":"admin","displayName":"Administrator"},{"username":"rahul","passwordHash":"$2a$10$replace_with_a_real_bcrypt_hash","role":"user","displayName":"Rahul"}]

# AUTH_JWT_SECRET — signs and verifies session tokens. Use a long random
# string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=replace_with_a_long_random_secret
